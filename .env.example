# ============================================
# DOUGLAS CEL - ARQUIVO DE CONFIGURAÇÃO
# ============================================
# 
# Este arquivo contém as variáveis de configuração
# da landing page. Copie este arquivo para .env
# e preencha com seus valores reais.
#
# IMPORTANTE: NUNCA commite o arquivo .env com
# dados sensíveis para o repositório público!
#
# ============================================

# 1. CONFIGURAÇÃO FORMSPREE
# ============================================
# Obter em: https://formspree.io
# Formato: f/xyz123abc456
FORMSPREE_ID=f/YOUR_FORMSPREE_ID_HERE

# 2. CONFIGURAÇÃO GOOGLE APPS SCRIPT
# ============================================
# Obter ao fazer deploy em Google Apps Script
# Formato: https://script.google.com/macros/d/ABC123.../userfunctionbyname
GOOGLE_SCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID_HERE/userfunctionbyname

# 3. CONFIGURAÇÃO SHEETY
# ============================================
# Obter em: https://sheety.co
SHEETY_URL=https://api.sheety.co/YOUR_PROJECT_ID/douglasCel/leads
SHEETY_TOKEN=YOUR_SHEETY_TOKEN_HERE

# 4. INFORMAÇÕES DA EMPRESA
# ============================================
COMPANY_NAME=Douglas Cel
COMPANY_EMAIL=contato@douglascel.com
COMPANY_PHONE=+5511999999999
COMPANY_WHATSAPP=5511999999999

# 5. CONFIGURAÇÃO GOOGLE ANALYTICS
# ============================================
# Obter em: https://analytics.google.com
GOOGLE_ANALYTICS_ID=G-YOUR_TRACKING_ID

# 6. CONFIGURAÇÃO EMAIL
# ============================================
# Email para receber notificações de novos leads
NOTIFICATION_EMAIL=seu-email@douglascel.com

# 7. CONFIGURAÇÃO DE DESENVOLVIMENTO
# ============================================
# Valores: development, production
ENVIRONMENT=development

# 8. URLS DE REDIRECIONAMENTO
# ============================================
# URL da landing page
SITE_URL=https://seu-dominio.com
# URL de sucesso após enviar formulário
SUCCESS_URL=https://seu-dominio.com/obrigado
# URL de erro
ERROR_URL=https://seu-dominio.com/erro

# 9. CONFIGURAÇÃO DE SEGURANÇA
# ============================================
# Ativar CORS (Cross-Origin Resource Sharing)
CORS_ENABLED=true
# Domínios permitidos (separados por vírgula)
ALLOWED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com